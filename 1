-- geser jendela lewat judul (mouse dan sentuhan)
do
    local dragging, dragStart, startPos
    title.Active = true
    title.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging, dragStart, startPos = true, input.Position, frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
end

---------------------------------------------------------------- loop
task.spawn(function() -- refresh status
    while gui.Parent and not state.Stop do
        local cash = getCash()
        info.Text = ("Base: %s\nUang: %s\nTombol tersisa: %d\nTerbeli: %d\nStatus: %s"):format(
            tycoon.Name, cash and tostring(cash) or "tak terbaca",
            #folder:GetChildren(), state.Bought, state.Status)
        task.wait(0.5)
    end
end)

task.spawn(function() -- loop beli
    while not state.Stop and not getgenv().AutoBuyStop do
        if state.Enabled then
            local ok, err = pcall(step)
            if not ok then warn("[AutoBuy] error:", err) end
        else
            state.Status = "OFF"
        end
        task.wait(CONFIG.Interval)
    end
end)
