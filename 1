-- Posisi berdiri tepat di atas permukaan part (tahan rotasi dan bentuk)
local function standCFrame(part, hrp)
    local hum = hrp.Parent and hrp.Parent:FindFirstChildOfClass("Humanoid")
    local hip = 2
    if hum then
        hip = (hum.RigType == Enum.HumanoidRigType.R6) and 2 or hum.HipHeight
    end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Include
    params.FilterDescendantsInstances = { part }
    local hit = workspace:Raycast(
        part.Position + Vector3.new(0, 30, 0), Vector3.new(0, -60, 0), params)
    local topY
    if hit then
        topY = hit.Position.Y
    else
        local _, _, _, _, _, _, r10, r11, r12 = part.CFrame:GetComponents()
        topY = part.Position.Y + (math.abs(r10) * part.Size.X
            + math.abs(r11) * part.Size.Y + math.abs(r12) * part.Size.Z) / 2
    end
    local rot = hrp.CFrame - hrp.CFrame.Position
    local pos = Vector3.new(part.Position.X,
        topY + hip + hrp.Size.Y / 2 + CONFIG.TpLift, part.Position.Z)
    return CFrame.new(pos) * rot
end

-- Jalan kecil sungguhan setelah TP supaya server menghitung sentuhan
local function nudge(hrp, baseCF, part)
    local hum = hrp.Parent and hrp.Parent:FindFirstChildOfClass("Humanoid")
    local d = CONFIG.WalkDist
    if part then
        d = math.min(d, math.max(part.Size.X, part.Size.Z) / 3)
    end
    local c = baseCF.Position

    if hum then
        task.wait(CONFIG.PreWalkWait)
        local y = hrp.Position.Y
        local points = {
            Vector3.new(c.X + d, y, c.Z), Vector3.new(c.X - d, y, c.Z),
            Vector3.new(c.X, y, c.Z + d), Vector3.new(c.X, y, c.Z - d),
            Vector3.new(c.X, y, c.Z),
        }
        for _ = 1, CONFIG.WalkPasses do
            for _, p in ipairs(points) do
                hum:MoveTo(p)
                local t0 = os.clock()
                while (Vector3.new(hrp.Position.X, 0, hrp.Position.Z)
                        - Vector3.new(p.X, 0, p.Z)).Magnitude > 0.4
                    and os.clock() - t0 < CONFIG.WalkTimeout do
                    task.wait()
                end
            end
        end
        hum:MoveTo(hrp.Position) -- berhenti
    else
        for _, off in ipairs({ Vector3.new(d, 0, 0), Vector3.new(-d, 0, 0) }) do
            hrp.CFrame = baseCF + off
            task.wait(0.1)
        end
        hrp.CFrame = baseCF
    end

    if CONFIG.NudgeJump and hum then
        hum:ChangeState(Enum.HumanoidStateType.Jumping)
        task.wait(0.4)
    end
end

local function getCash()
    local ls = LP:FindFirstChild("leaderstats")
    if ls then
        for _, v in ipairs(ls:GetChildren()) do
            local n = v.Name:lower()
            if (n:find("cash") or n:find("money") or n:find("coin")) and v:IsA("ValueBase") then
                return tonumber(v.Value)
            end
        end
    end
    for _, key in ipairs({ "Cash", "Money", "Coins" }) do
        local a = LP:GetAttribute(key)
        if tonumber(a) then return tonumber(a) end
    end
    return nil
end

local rebirthInst
local function getRebirths()
    if tonumber(getgenv().AutoBuyRebirth) then
        return tonumber(getgenv().AutoBuyRebirth)
    end
    if rebirthInst and rebirthInst.Parent then
        return tonumber(rebirthInst.Value)
    end
    local ls = LP:FindFirstChild("leaderstats")
    if ls then
        for _, v in ipairs(ls:GetChildren()) do
            if v:IsA("ValueBase") and v.Name:lower():find("rebirth", 1, true)
                and tonumber(v.Value) then
                rebirthInst = v
                return tonumber(v.Value)
            end
        end
    end
    for k, v in pairs(LP:GetAttributes()) do
        if k:lower():find("rebirth", 1, true) and tonumber(v) then
            return tonumber(v)
        end
    end
    return nil
end

local function waitIdle()
    local t = os.clock()
    while state.Busy and os.clock() - t < 5 do task.wait(0.1) end
end

---------------------------------------------------------------- pembaca tombol
local SUFFIX = { K = 1e3, M = 1e6, B = 1e9, T = 1e12 }
local function parseText(text)
    local low = text:lower()
    if low:find("r$", 1, true) or low:find("robux", 1, true) or low:find("medal", 1, true) then
        return nil
    end
    local num, suf = text:match("%$%s*([%d,%.]+)%s*([KMBTkmbt]?)")
    if not num then return nil end
    local n = tonumber((num:gsub(",", "")))
    return n and n * (SUFFIX[suf:upper()] or 1) or nil
end

local priceCache = setmetatable({}, { __mode = "k" })
local function getPrice(inst)
    if priceCache[inst] then return priceCache[inst] end
    local price
    for _, key in ipairs({ "Price", "Cost", "price", "cost" }) do
        local a = inst:GetAttribute(key)
        if tonumber(a) then price = tonumber(a) break end
        local v = inst:FindFirstChild(key)
        if v and v:IsA("ValueBase") and tonumber(v.Value) then
            price = tonumber(v.Value) break
        end
    end
    if not price then
        for _, d in ipairs(inst:GetDescendants()) do
            if d:IsA("TextLabel") or d:IsA("TextButton") then
                price = parseText(d.Text)
                if price then break end
            end
        end
    end
    if price then priceCache[inst] = price end
    return price
end

local skipCache = setmetatable({}, { __mode = "k" })
local function computeSkip(inst)
    local name = inst.Name:lower()
    for _, s in ipairs(CONFIG.SkipNames) do
        if name:find(s, 1, true) then return true end
    end
    for _, d in ipairs(inst:GetDescendants()) do
        local dn = d.Name:lower()
        if dn:find("medalprice", 1, true) or dn:find("robux", 1, true)
            or dn:find("gamepass", 1, true) or dn:find("productid", 1, true) then
            return true
        end
        if d:IsA("TextLabel") or d:IsA("TextButton") then
            local t = d.Text:lower()
            for _, s in ipairs(CONFIG.SkipTexts) do
                if t:find(s, 1, true) then return true end
            end
        end
    end
    return false
end

local function isSkipped(inst)
    local c = skipCache[inst]
    if c and (c.skip or os.clock() - c.t < 10) then return c.skip end
    local skip = computeSkip(inst)
    skipCache[inst] = { skip = skip, t = os.clock() }
    return skip
end

local reqCache = setmetatable({}, { __mode = "k" })
local function getRebirthReq(inst)
    local c = reqCache[inst]
    if c and (c.v or os.clock() - c.t < 10) then return c.v end
    local req
    for _, d in ipairs(inst:GetDescendants()) do
        if d:IsA("TextLabel") or d:IsA("TextButton") then
            local n = d.Text:lower():match("(%d+)%s*rebirth")
            if n then req = tonumber(n) break end
        end
    end
    reqCache[inst] = { v = req, t = os.clock() }
    return req
end

local function getTouchPart(inst)
    if inst:IsA("BasePart") then return inst end
    local fallback
    for _, d in ipairs(inst:GetDescendants()) do
        if d:IsA("BasePart") then
            if d:FindFirstChildOfClass("TouchTransmitter") then return d end
            fallback = fallback or d
        end
    end
    return (inst:IsA("Model") and inst.PrimaryPart) or fallback
end

local function isGreen(part)
    local c = part.Color
    return c.G > c.R and c.G > c.B
end

local function listButtons()
    local list = {}
    if not folder then return list end
    local rb = getRebirths()
    for _, inst in ipairs(folder:GetChildren()) do
        if not isSkipped(inst) then
            local part = getTouchPart(inst)
            if part then
                local price = getPrice(inst)
                local req = getRebirthReq(inst)
                local allowed = true
                if req then allowed = (rb ~= nil and rb >= req) end
                if allowed and (price or req) then
                    table.insert(list, {
                        inst = inst, part = part,
                        price = price or 0,
                        unknownPrice = (price == nil),
                        key = price or 1e18,
                    })
                end
            end
        end
    end
    table.sort(list, function(a, b) return a.key < b.key end)
    return list
end

---------------------------------------------------------------- AutoBuy
local attempts = {}

local function startMethod()
    return CONFIG.PreferTeleport and 2 or 1
end

local function doTouch(hrp, part, method)
    if method == 1 and typeof(firetouchinterest) == "function" then
        firetouchinterest(hrp, part, 0)
        task.wait(CONFIG.TouchDelay)
        firetouchinterest(hrp, part, 1)
    else
        local old = hrp.CFrame
        local target = standCFrame(part, hrp)
        hrp.CFrame = target
        task.wait(CONFIG.TouchDelay)
        nudge(hrp, target, part)
        hrp.CFrame = old
    end
end

local function buy(hrp, item)
    local st = attempts[item.inst] or { method = startMethod(), blockedUntil = 0 }
    attempts[item.inst] = st
    local cashBefore = getCash()
    state.Status = "Membeli: " .. item.inst.Name
    local ok, err = pcall(doTouch, hrp, item.part, st.method)
    if not ok then warn("[AutoTycoon] error beli:", err) end
    task.wait(CONFIG.VerifyDelay)

    local after = getCash()
    if item.inst.Parent ~= folder or (cashBefore and after and after < cashBefore) then
        state.Bought += 1
        state.Status = "Terbeli: " .. item.inst.Name
        attempts[item.inst] = nil
        return
    end
    if st.method == 1 then
        st.method = 2
    else
        st.method = startMethod()
        st.blockedUntil = os.clock()
            + (item.unknownPrice and CONFIG.UnknownPriceBlacklist or CONFIG.BlacklistTime)
        state.Status = "Belum bisa: " .. item.inst.Name
    end
end

local function buyStep()
    local hrp = getHRP()
    if not hrp or not folder then return end
    local cash = getCash()
    local now = os.clock()

    local list = listButtons()
    state.Total = #folder:GetChildren()
    state.Priced = 0

    local candidates = {}
    for _, item in ipairs(list) do
        if not item.unknownPrice then state.Priced += 1 end
        local st = attempts[item.inst]
        if not (st and st.blockedUntil > now) then
            local afford
            if item.unknownPrice then
                afford = true
            elseif cash ~= nil then
                afford = cash >= item.price
            else
                afford = (not CONFIG.UseColorGate) or isGreen(item.part)
            end
            if afford then table.insert(candidates, item) end
        end
    end
    state.Afford = #candidates

    if #candidates == 0 then
        state.Status = "Menunggu uang / tombol"
        return
    end
    for _, item in ipairs(candidates) do
        if not state.BuyOn or not alive() then return end
        if item.inst.Parent == folder then
            local c = getCash()
            if c == nil or c >= item.price then
                hrp = getHRP() or hrp
                buy(hrp, item)
            end
        end
    end
end

---------------------------------------------------------------- AutoCollect
local function atmPos()
    if atmStore[tycoon.Name] then return atmStore[tycoon.Name] end
    if ess then
        local sp = ess:FindFirstChild("BaseSpawn")
        if sp and sp:IsA("BasePart") then return sp.Position end
    end
    local hrp = getHRP()
    return hrp and hrp.Position
end

local function findCollector(timeout)
    if not ess then return nil end
    local model = ess:FindFirstChild("CollectorParts")
    if not model then return nil end
    local part = model:FindFirstChild("Collector") or model:WaitForChild("Collector", timeout)
    if part and part:IsA("BasePart") then
        atmStore[tycoon.Name] = part.Position -- simpan posisi akurat
        return part
    end
    return nil
end

local function fireTouch(hrp, part)
    if typeof(firetouchinterest) ~= "function" then return false end
    firetouchinterest(hrp, part, 0)
    task.wait(CONFIG.TouchDelay)
    firetouchinterest(hrp, part, 1)
    return true
end

local COLLECT = {
    [1] = function(hrp)
        local pos = atmPos()
        if pos then
            pcall(function() LP:RequestStreamAroundAsync(pos, CONFIG.StreamTimeout) end)
        end
        local part = findCollector(CONFIG.StreamTimeout)
        if not part then
            state.CollectStatus = "Collector belum termuat"
            return
        end
        fireTouch(hrp, part)
    end,
    [2] = function(hrp)
        local pos = atmPos()
        if not pos then return end
        local old = hrp.CFrame
        hrp.CFrame = CFrame.new(pos + Vector3.new(0, 4, 0))
        local part = findCollector(CONFIG.StreamTimeout + 2)
        if part then
            local target = standCFrame(part, hrp)
            hrp.CFrame = target
            task.wait(0.3)
            fireTouch(hrp, part)
            nudge(hrp, target, part)
            task.wait(0.3)
        else
            state.CollectStatus = "Collector tidak muncul"
        end
        hrp.CFrame = old
    end,
}
local COLLECT_NAMES = { "stream + sentuh", "teleport + jalan" }
local collectMethod, collectLocked, collectFails = startMethod(), false, 0

local function collectStep()
    if not ess then return end
    if CONFIG.UseCanCollect and canCollectVal and canCollectVal.Value ~= true then
        state.CollectStatus = "ATM belum siap (CanCollect=false)"
        return
    end
    local hrp = getHRP()
    if not hrp then return end

    if not lastCollectVal then collectMethod = 2 end
    local before = lastCollectVal and lastCollectVal.Value
    local ok, err = pcall(COLLECT[collectMethod], hrp)
    if not ok then warn("[AutoTycoon] error collect:", err) end
    task.wait(CONFIG.VerifyDelay + 0.3)

    if not lastCollectVal then
        state.CollectStatus = "Collect dikirim (tak terverifikasi)"
        return
    end
    local after = lastCollectVal.Value
    if before ~= after then
        collectLocked, collectFails = true, 0
        state.CollectStatus = "OK via " .. COLLECT_NAMES[collectMethod]
    else
        collectFails += 1
        if collectLocked and collectFails >= 3 then collectLocked = false end
        if not collectLocked then
            state.CollectStatus = "Tanpa efek: " .. COLLECT_NAMES[collectMethod]
            collectMethod = collectMethod % #COLLECT + 1
        end
    end
end

---------------------------------------------------------------- TP
local function tpNextButton()
    waitIdle()
    local hrp = getHRP()
    if not hrp then return end
    local list = listButtons()
    if #list == 0 then
        state.Status = "Tidak ada tombol"
        return
    end
    state.TpIndex = state.TpIndex % #list + 1
    local item = list[state.TpIndex]
    local target = standCFrame(item.part, hrp)
    hrp.CFrame = target
    nudge(hrp, target, item.part)
    state.Status = ("TP %d/%d: %s"):format(state.TpIndex, #list, item.inst.Name)
end

local function tpBase()
    waitIdle()
    local hrp = getHRP()
    if not hrp then return end
    local target
    local sp = ess and ess:FindFirstChild("BaseSpawn")
    if sp and sp:IsA("BasePart") then
        target = standCFrame(sp, hrp)
    else
        local ok, cf = pcall(function() return tycoon:GetPivot() end)
        if ok then target = cf + Vector3.new(0, 6, 0) end
    end
    if target then
        hrp.CFrame = target
        state.Status = "TP ke base " .. tycoon.Name
    else
        state.Status = "Posisi base tidak ditemukan"
    end
end

local function tpAtm()
    waitIdle()
    local hrp = getHRP()
    local pos = atmPos()
    if hrp and pos then
        hrp.CFrame = CFrame.new(pos + Vector3.new(0, 4, 0))
        state.Status = "TP ke ATM"
    end
end

local function saveAtm()
    local hrp = getHRP()
    if hrp then
        atmStore[tycoon.Name] = hrp.Position
        state.Status = "Posisi ATM disimpan"
    end
end

---------------------------------------------------------------- Extractor loop
task.spawn(function()
    local ev
    local ok, e = pcall(function()
        return RS:WaitForChild("Packages", 10):WaitForChild("Knit", 10)
            :WaitForChild("Services", 10):WaitForChild("BaseService", 10)
            :WaitForChild("RE", 10):WaitForChild("DefaultExtractorTrigger", 10)
    end)
    ev = ok and e or nil
    if not ev then warn("[AutoTycoon] Event extractor tidak ditemukan.") end
    if typeof(firesignal) ~= "function" then
        warn("[AutoTycoon] Executor tidak mendukung firesignal.")
        ev = nil
    end
    while ev and alive() do
        if state.ExtractorOn then
            local ok2, err = pcall(function() firesignal(ev.OnClientEvent) end)
            if ok2 then state.ExtCount += 1 else warn("[AutoTycoon] extractor:", err) end
        end
        task.wait(CONFIG.ExtractorInterval)
    end
end)

