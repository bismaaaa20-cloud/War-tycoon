task.spawn(function() -- segarkan label status
	local last = {}
	local function put(label, key, text)
		if last[key] ~= text then
			last[key] = text
			pcall(function() label:Set(text) end)
		end
	end
	while alive() do
		local cash = getCash()
		put(lblMoney, "m", "Uang: " .. (cash and tostring(cash) or "tak terbaca (pakai warna)")
			.. " | Terbeli: " .. state.Bought)
		put(lblButtons, "b", ("Tombol: %d total | %d berharga | %d mampu"):format(
			state.Total, state.Priced, state.Afford))
		put(lblCollect, "c", "Collect: " .. state.CollectStatus .. " | Extractor: " .. state.ExtCount)
		put(lblStatus, "s", "Status: " .. state.Status)
		put(lblRebirth, "r", "Rebirth: " .. rebirthText())
		task.wait(0.5)
	end
end)

task.spawn(function() -- penjadwal tunggal: collect lalu beli, tanpa tabrakan teleport
	local lastCollect = 0
	while alive() do
		local now = os.clock()
		if state.CollectOn and ess and now - lastCollect >= CONFIG.CollectInterval then
			lastCollect = now
			state.Busy = true
			local ok, err = pcall(collectStep)
			state.Busy = false
			if not ok then warn("[AutoTycoon] collect:", err) end
		end
		if state.BuyOn and folder then
			state.Busy = true
			local ok, err = pcall(buyStep)
			state.Busy = false
			if not ok then warn("[AutoTycoon] buy:", err) end
		elseif not state.BuyOn then
			state.Status = "AutoBuy OFF"
		end
		task.wait(CONFIG.BuyInterval)
	end
end)