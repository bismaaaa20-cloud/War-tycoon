end)

task.spawn(function() -- penjadwal tunggal: collect lalu beli, tanpa tabrakan teleport
    local lastCollect = 0
    while not state.Stop and not getgenv().AutoTycoonStop do
        local now = os.clock()
        if state.CollectOn and ess and now - lastCollect >= CONFIG.CollectInterval then
            lastCollect = now
            state.Busy = true
            local ok, err = pcall(collectStep)
            state.Busy = false
            if not ok then warn("[AutoTycoon] collect:", err) end
        end
        if state.BuyOn and folder then
            state.Busy = true
            local ok, err = pcall(buyStep)
            state.Busy = false
            if not ok then warn("[AutoTycoon] buy:", err) end
        elseif not state.BuyOn then
            state.Status = "AutoBuy OFF"
        end
        task.wait(CONFIG.BuyInterval)
    end
end)