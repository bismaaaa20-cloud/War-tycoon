local function detectTycoon()
	for _ = 1, 10 do
		local ok, tycoons = pcall(function()
			return workspace:WaitForChild("Tycoon", 10):WaitForChild("Tycoons", 10)
		end)
		if ok and tycoons then
			for _, t in ipairs(tycoons:GetChildren()) do
				local o = t:FindFirstChild("Owner")
				if o and o:IsA("ValueBase") and o.Value == LP then
					return t
				end
			end
		end
		task.wait(1)
	end
	return nil
end

