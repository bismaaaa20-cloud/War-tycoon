---------------------------------------------------------------- baca rebirth
local function readRebirth()
    if tonumber(getgenv().AutoBuyRebirth) then
        return tonumber(getgenv().AutoBuyRebirth), "override manual (getgenv().AutoBuyRebirth)"
    end
    local ls = LP:FindFirstChild("leaderstats")
    if ls then
        for _, v in ipairs(ls:GetChildren()) do
            if v:IsA("ValueBase") and v.Name:lower():find("rebirth", 1, true) and tonumber(v.Value) then
                return tonumber(v.Value), v:GetFullName()
            end
        end
    end
    for k, v in pairs(LP:GetAttributes()) do
        if k:lower():find("rebirth", 1, true) and tonumber(v) then
            return tonumber(v), "Attribute " .. k
        end
    end
    for _, child in ipairs(LP:GetChildren()) do
        if child.Name ~= "PlayerGui" and child.Name ~= "Backpack" and child.Name ~= "PlayerScripts" then
            for _, d in ipairs(child:GetDescendants()) do
                if d:IsA("ValueBase") and d.Name:lower():find("rebirth", 1, true) and tonumber(d.Value) then
                    return tonumber(d.Value), d:GetFullName()
                end
            end
        end
    end
    return nil, "tidak ditemukan"
end

local rb, src = readRebirth()
add("== REBIRTH-MU ==")
add("Nilai: " .. tostring(rb) .. " | Sumber: " .. src)

if rb == nil then
    add("Mencari kandidat lain di ReplicatedStorage...")
