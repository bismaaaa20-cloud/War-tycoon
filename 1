        if i % 2000 == 0 then task.wait() end
    end
    if found == 0 then add("  Tidak ada. Pakai override: getgenv().AutoBuyRebirth = <angka>") end
end

---------------------------------------------------------------- pembaca tombol
local SUFFIX = { K = 1e3, M = 1e6, B = 1e9, T = 1e12 }
local function parsePrice(text)
    local low = text:lower()
    if low:find("r$", 1, true) or low:find("robux", 1, true) or low:find("medal", 1, true) then return nil end
    local num, suf = text:match("%$%s*([%d,%.]+)%s*([KMBTkmbt]?)")
    if not num then return nil end
    local n = tonumber((num:gsub(",", "")))
    return n and n * (SUFFIX[suf:upper()] or 1) or nil
end

local function inspect(inst)
    local info = { name = inst.Name, texts = {}, skip = false }
    for _, d in ipairs(inst:GetDescendants()) do
        if d:IsA("TextLabel") or d:IsA("TextButton") then
            local t = d.Text
            if t ~= "" then table.insert(info.texts, t) end
            local low = t:lower()
            for _, s in ipairs(CONFIG.SkipTexts) do
                if low:find(s, 1, true) then info.skip = true end
            end
            info.price = info.price or parsePrice(t)
            local n = low:match("(%d+)%s*rebirth")
            if n and not info.req then info.req = tonumber(n) end
        end
        local dn = d.Name:lower()
        if dn:find("medalprice", 1, true) or dn:find("gamepass", 1, true)
            or dn:find("productid", 1, true) or dn:find("robux", 1, true) then
            info.skip = true
        end
    end
    return info
end

local function decide(info, level)
    if info.skip then return "SKIP (hadiah/robux/medals)" end
    if info.req then
        if level == nil then return "SKIP (rebirth tak terbaca)" end
        if level < info.req then return ("SKIP (butuh %d, kamu %d)"):format(info.req, level) end
        return info.price and "AMBIL (syarat terpenuhi)" or "AMBIL (syarat terpenuhi, harga tak diketahui)"
    end
    if info.price then return "AMBIL (harga uang)" end
    return "SKIP (tanpa harga)"
end

---------------------------------------------------------------- laporan
local infos = {}
for _, inst in ipairs(folder:GetChildren()) do
    table.insert(infos, inspect(inst))
end
table.sort(infos, function(a, b) return (a.req or 0) > (b.req or 0) end)

add("== TOMBOL BERSYARAT REBIRTH ==")
local gated = {}
for _, info in ipairs(infos) do
    if info.req then
        table.insert(gated, info)
        add(("%s | butuh %d | harga %s | %s"):format(
            info.name, info.req, tostring(info.price or "tak ada"), decide(info, rb)))
    end
end
if #gated == 0 then add("Tidak ada tombol bersyarat rebirth di folder ini.") end

add("== RINGKASAN KEPUTUSAN (rebirth saat ini) ==")
local count = { take = 0, skip = 0 }
for _, info in ipairs(infos) do
    if decide(info, rb):sub(1, 5) == "AMBIL" then count.take += 1 else count.skip += 1 end
end
add(("Total tombol: %d | diambil: %d | dilewati: %d"):format(#infos, count.take, count.skip))

if #gated > 0 then
    add("== SIMULASI LEVEL REBIRTH ==")
    for _, level in ipairs(CONFIG.SimLevels) do
        local open = {}
        for _, info in ipairs(gated) do
            if not info.skip and level >= info.req then table.insert(open, info.name) end
        end
        add(("Rebirth %d -> terbuka: %s"):format(level,
            #open > 0 and table.concat(open, ", ") or "(tidak ada)"))
    end
end

