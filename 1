local function addStepper(tab, title, sub, get, set, step, minv, maxv, fmt)
    local r = newRow(tab, 46)
    rowTexts(r, title, sub, 150)
    local val = mkLabel(r, "", 13, THEME.text, FONT_X, Enum.TextXAlignment.Center)
    val.Position = UDim2.new(1, -112, 0, 0)
    val.Size = UDim2.fromOffset(52, 46)
    local function paint() val.Text = (fmt or "%g"):format(get()) end
    local function bump(delta)
        local v = math.clamp(math.floor((get() + delta) * 100 + 0.5) / 100, minv, maxv)
        set(v)
        paint()
    end
    local function mk(text, x, delta)
        local b = Instance.new("TextButton")
        b.Size = UDim2.fromOffset(32, 30)
        b.Position = UDim2.new(1, x, 0.5, -15)
        b.BackgroundColor3 = THEME.off
        b.Text = text
        b.TextColor3 = THEME.text
        b.Font = FONT_X
        b.TextSize = 18
        b.Parent = r
        corner(b, 6)
        b.MouseButton1Click:Connect(function() bump(delta) end)
    end
    mk("-", -144, -step)
    mk("+", -44, step)
    paint()
    table.insert(updaters, paint)
end

