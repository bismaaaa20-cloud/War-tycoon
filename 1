local function addToggle(tab, title, sub, get, set)
    local r = newRow(tab, 46)
    rowTexts(r, title, sub, 64)
    local trackF = Instance.new("Frame")
    trackF.Size = UDim2.fromOffset(46, 24)
    trackF.Position = UDim2.new(1, -58, 0.5, -12)
    trackF.BorderSizePixel = 0
    trackF.Parent = r
    corner(trackF, 12)
    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(18, 18)
    knob.BackgroundColor3 = Color3.new(1, 1, 1)
    knob.BorderSizePixel = 0
    knob.Parent = trackF
    corner(knob, 9)
    local function paint(animate)
        local on = get()
        local pos = on and UDim2.fromOffset(25, 3) or UDim2.fromOffset(3, 3)
        if animate then
            TweenService:Create(knob, TweenInfo.new(0.12), { Position = pos }):Play()
        else
            knob.Position = pos
        end
        trackF.BackgroundColor3 = on and THEME.accent or THEME.off
    end
    local btn = Instance.new("TextButton")
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.Size = UDim2.fromScale(1, 1)
    btn.Parent = r
    btn.MouseButton1Click:Connect(function() set(not get()); paint(true) end)
    paint(false)
    table.insert(updaters, function() paint(false) end)
end

